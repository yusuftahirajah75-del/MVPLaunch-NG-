# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
APP_NAME=MVPLaunch NG
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mvplaunch_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mvplaunch_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000

# Authentication (JWT)
JWT_SECRET=mvplaunch_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=mvplaunch_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Paystack Payment Provider (Nigeria)
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_here
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_MOCK_MODE=true

# Storage Provider (local | s3 | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Email Provider (mock | smtp | resend)
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@mvplaunch.ng
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
